{
  "schema_version": 1,
  "scope": "contracts-and-identity",
  "backend_outputs": [
    "openapi.json",
    "errors.json",
    "telemetry.json",
    "permissions.json",
    "database-schema.json",
    "material-import-contract.json",
    "user-notification-contract.json",
    "version.json"
  ],
  "backend": {
    "source": [
      "backend/app/schemas",
      "backend/app/api",
      "backend/app/contracts",
      "backend/app/core/logging.py",
      "backend/app/models"
    ],
    "generator": "backend/app/contracts/export.py",
    "output": "contracts",
    "ownership": "backend"
  },
  "frontend": [
    {
      "source": [
        "frontend/config/ui_test_ids.json"
      ],
      "generator": "frontend/tool/generate.py",
      "output": [
        "frontend/lib/generated/ui_test_ids.dart"
      ],
      "ownership": "frontend"
    },
    {
      "source": [
        "frontend/config/build_targets.json"
      ],
      "generator": "frontend/tool/generate.py",
      "output": [
        "frontend/lib/generated/build_targets.dart",
        "frontend/windows/haruka_build_targets.cmake"
      ],
      "ownership": "frontend"
    },
    {
      "source": [
        "frontend/lib/l10n/app_zh.arb",
        "frontend/l10n.yaml",
        "frontend/pubspec.yaml"
      ],
      "generator": "frontend/tool/generate.py (locked Flutter gen-l10n)",
      "output": [
        "frontend/lib/generated/l10n/app_localizations.dart",
        "frontend/lib/generated/l10n/app_localizations_zh.dart"
      ],
      "ownership": "frontend"
    },
    {
      "source": [
        "frontend/pubspec.lock",
        "tools/toolchain.json"
      ],
      "generator": "locked Flutter plugin tooling",
      "output": [
        "frontend/windows/flutter/generated_plugin_registrant.cc",
        "frontend/windows/flutter/generated_plugin_registrant.h",
        "frontend/windows/flutter/generated_plugins.cmake"
      ],
      "ownership": "frontend"
    },
    {
      "source": [
        "contracts/errors.json",
        "contracts/openapi.json",
        "tools/codegen/dart-api/transition.json"
      ],
      "generator": "frontend/tool/generate.py",
      "output": [
        "frontend/lib/generated/api_catalog.dart"
      ],
      "ownership": "frontend"
    }
  ],
  "dart_api": {
    "status": "centralized-handwritten-contract",
    "evaluation": "tools/codegen/dart-api/transition.json",
    "reason": "dart-dio 7.25.0 generates invalid unions; the reviewed long-term contract is centralized handwritten DTOs, generated Python/Dart compatibility samples and an independently reviewed full-schema fingerprint",
    "source": [
      "backend/tests/support/api_compatibility.py",
      "backend/app/schemas/scalars.py"
    ],
    "generator": "backend/tools/export_compatibility.py",
    "test_fixture_output": "frontend/test/support/generated/api_compatibility_samples.dart",
    "output": [
      "tools/codegen/dart-api/fixtures/openapi.json",
      "tools/codegen/dart-api/fixtures/samples.json",
      "tools/codegen/dart-api/fixtures/manifest.json"
    ]
  }
}
