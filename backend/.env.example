# Explicit local shell configuration. Environment variables override this file.
# No database, account, model or production capability is enabled by this slice.
HARUKA_APP_ENV=dev
HARUKA_INSTANCE_ID=haruka-local-dev
HARUKA_PUBLIC_BASE_URL=http://127.0.0.1:8000
HARUKA_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
HARUKA_RELEASE=0.1.0
# Offline process shell only. For real clients, run scripts/dev.py infra up
# and select the generated dev/.local/backend.env explicitly.
HARUKA_INFRASTRUCTURE_ENABLED=false
