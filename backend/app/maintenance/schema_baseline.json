      "ck_source_result_bindings_learning_binding_digest": "octet_length(binding_digest) = 32",
      "ck_source_result_bindings_learning_result": "result_kind IN ('card') AND result_version >= 1",
      "ck_source_result_bindings_learning_source": "source_kind IN ('material') AND source_schema_version >= 1",
